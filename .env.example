# Every variable here is optional — the app builds and runs with none of them
# set. What changes is which features work; each block says what happens when
# it's unset. Copy to .env.local and fill in only what you need.

# Environment
# development | production. Gates production-only integrations (analytics).
# Unset behaves as development. Set it explicitly on every deploy.
APP_ENV=development

# Google API keys
# Get one at: https://aistudio.google.com/api-keys
# Unset → the two AI tools are unavailable on the hosted path; visitors can
# still use them by adding their own key in the UI (BYOK).
GOOGLE_API_KEY=""

# Optional per-tool key overrides, so each tool bills to its own key and shows
# separate AI Studio metrics. Blank or unset falls back to GOOGLE_API_KEY.
# GOOGLE_API_KEY_ARTICLE_TO_SEO_META=""
# GOOGLE_API_KEY_ARTICLE_TO_SOCIAL_POST=""

# Upstash Redis — the daily quota counters for the hosted AI tools
# Get credentials at: https://console.upstash.com/redis
# Unset → hosted generations are REFUSED in any built/deployed app (they can't
# be metered, and unmetered means unbounded spend on the key above); the dev
# server skips metering entirely, so local work needs no Upstash account.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# IP hashing (production)
# Secret pepper so rate-limit IP hashes aren't brute-force reversible.
# Generate one with: openssl rand -hex 32
# Unset → plain SHA-256 (fine for local/self-host; warns in production).
IP_HASH_SECRET=""

